# ==============================================================================
# AI Workbench / Summertime Server .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.bak*

# Virtual Environments
venv/
.venv/
env/
venv.*/
.env.reference/

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.key
*.pem
token.json
credentials.json

# Databases & Runtime Locks
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.pid
data/*.pid
storage/
.qdrant-initialized

# Logs
logs/
*.log
llama_swap.err

# Heavy Model Binaries & GGUFs (Do NOT commit to git)
models/
model_cache/
*.gguf
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.bin

# Compiled Binaries & DLLs
*.exe
*.dll
*.so
*.dylib
bin/*.dll
bin/*.exe

# Whitelist tracked Linux binary and license
!bin/llama-swap
!bin/LICENSE-LLVM-OpenMP

# IDE & OS Artifacts
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Build Artifacts
build/
dist/
.coverage
htmlcov/
