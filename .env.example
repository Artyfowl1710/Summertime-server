# ==============================================================================
# AI WORKBENCH / SUMMERTIME SERVER ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure for your host environment:
#     cp .env.example .env
#
# To bootstrap your initial superuser API key, run:
#     python -m server.cli.main admin bootstrap
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Network & Gateway Bindings
# ------------------------------------------------------------------------------
# Set HOST to 0.0.0.0 to allow remote client devices on LAN/WAN to connect.
HOST=0.0.0.0
PORT=8000

# Base URL used for self-referential links, admin CLI tools, and client exports.
# In production, replace with your server's LAN IP or DNS domain name:
# e.g., http://192.168.1.100:8000 or https://ai-server.yourdomain.com
WORKBENCH_API_BASE=http://0.0.0.0:8000

# ------------------------------------------------------------------------------
# 2. Authentication & Admin Security
# ------------------------------------------------------------------------------
# Primary superuser administrative key for managing models and issuing client keys.
# Run `python -m server.cli.main admin bootstrap` to generate a fresh secure key,
# or specify a minimum 32-character key starting with wb_live_
WORKBENCH_API_KEY=wb_live_change_me_or_run_admin_bootstrap_key

# ------------------------------------------------------------------------------
# 3. Database & State Storage
# ------------------------------------------------------------------------------
DB_PATH=data/workbench.db

# ------------------------------------------------------------------------------
# 4. Llama-Swap Model Engine Settings
# ------------------------------------------------------------------------------
# Linux: bin/llama-swap | Windows: bin/llama-swap.exe
LLAMASWAP_BIN=bin/llama-swap
LLAMASWAP_PORT=8100
LLAMASWAP_CONFIG=config/llama-swap.yaml
LLAMASWAP_WATCH_CONFIG=true

# ------------------------------------------------------------------------------
# 5. GPU & VRAM Memory Management
# ------------------------------------------------------------------------------
# Total VRAM budget in megabytes to reserve for model swapping (e.g. 6144 for 6GB, 12288 for 12GB, 24576 for 24GB)
VRAM_BUDGET_MB=6144

# ------------------------------------------------------------------------------
# 6. Qdrant Vector Database (RAG Support)
# ------------------------------------------------------------------------------
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333

# ------------------------------------------------------------------------------
# 7. TLS / HTTPS (Optional — Recommended when exposing over untrusted networks)
# ------------------------------------------------------------------------------
TLS_ENABLED=false
TLS_CERT_PATH=certs/server.crt
TLS_KEY_PATH=certs/server.key
